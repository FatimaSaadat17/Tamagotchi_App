{
  "name": "pocket-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A little desktop companion",
  "author": "Pocket Pet contributors",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.3.8"
  },
  "build": {
    "appId": "com.pocketpet.desktop",
    "productName": "Pocket Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "frontend/dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment"
    }
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
