{
  "name": "pocket-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A little desktop companion",
  "author": "Pocket Pet contributors",
  "homepage": "https://github.com/FatimaSaadat17/Tamagotchi_App",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run build && node scripts/build-backend.cjs && electron . --managed",
    "package": "npm run build && node scripts/build-backend.cjs --runtime && electron-builder --publish never",
    "check:package": "node scripts/check-package.cjs",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "start:ui": "electron ."
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.3.8"
  },
  "build": {
    "appId": "com.pocketpet.desktop",
    "productName": "Pocket Pet",
    "icon": "frontend/public/tama-egg.svg",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "frontend/dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment"
    },
    "win": {
      "target": ["zip"]
    },
    "linux": {
      "target": ["deb", "tar.gz"],
      "maintainer": "Pocket Pet contributors <FatimaSaadat17@users.noreply.github.com>",
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "backend/target/desktop",
        "to": "backend"
      },
      {
        "from": "compose.yaml",
        "to": "compose.yaml"
      },
      {
        "from": "compose.desktop.yaml",
        "to": "compose.desktop.yaml"
      }
    ]
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
